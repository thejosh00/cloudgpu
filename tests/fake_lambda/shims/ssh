#!/usr/bin/env python3
"""Stands in for ssh on the tests' PATH: records the call, answers as a fresh instance would."""
import json
import os
import sys

args = sys.argv[1:]
while args and args[0].startswith("-"):
    args = args[2:]  # up only passes `-o <option>` pairs
host, command = args[0], " ".join(args[1:])
with open(os.environ["FAKE_SHIM_LOG"], "a") as log:
    log.write(json.dumps({"tool": "ssh", "host": host, "command": command}) + "\n")

filesystem = os.environ["FAKE_SHIM_FILESYSTEM"]
detection = {"persistent_dir": f"/lambda/nfs/{filesystem}", "gpu": {"available": False}}
if command == "echo ok":
    print("ok")
elif "/lambda/nfs" in command and "listdir" in command:
    print(json.dumps({"mounts": [filesystem]}))
elif "python3 -m remote" in command and command.endswith(" detect"):
    print(json.dumps(detection))
elif "python3 -m remote" in command and command.endswith(" status"):
    # FAKE_SHIM_APPS: the apps the filesystem's state.json records, as JSON (default none).
    # FAKE_SHIM_APPS_AFTER_RECOVER, if set: what it records once a `recover` has run.
    apps = os.environ.get("FAKE_SHIM_APPS") or "{}"
    with open(os.environ["FAKE_SHIM_LOG"]) as log:
        recovered = any(json.loads(line)["command"].endswith(" recover") for line in log)
    if recovered and os.environ.get("FAKE_SHIM_APPS_AFTER_RECOVER"):
        apps = os.environ["FAKE_SHIM_APPS_AFTER_RECOVER"]
    print(json.dumps({"detection": detection, "apps": json.loads(apps)}))
elif "python3 -m remote" in command and command.endswith(" recover"):
    sys.exit(int(os.environ.get("FAKE_SHIM_RECOVER_EXIT") or 0))
elif "provision.py" in command or "provision.sh" in command:
    sys.exit(int(os.environ.get("FAKE_SHIM_PROVISION_EXIT") or 0))
