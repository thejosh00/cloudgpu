#!/usr/bin/env python3
"""Stands in for rsync on the tests' PATH: records the destination and copies nothing."""
import json
import os
import sys

destination = sys.argv[-1]
with open(os.environ["FAKE_SHIM_LOG"], "a") as log:
    log.write(json.dumps({"tool": "rsync", "host": destination.split(":", 1)[0], "command": destination}) + "\n")
